;; meta-signal-mind — meta-only policy/configuration wire contract
;; for PersonaMind.
;;
;; Wire-only: emits the rkyv + optional DOTOS codec and the signal-frame
;; request/reply envelope. Ordinary mind graph, work graph, query, and
;; subscription traffic stays in signal-mind; runtime actors, policy
;; evaluation, durable state, socket binding, and command lowering live in
;; mind.

{}
[Configure.Configuration Inspect.Inspection]
[Configured.PolicyRevision PolicySnapshot.PolicySnapshotPayload ConfigurationRejected.ConfigurationRejectedPayload RequestUnimplemented.RequestUnimplementedPayload]
{
  Configure.Configuration
  Inspect.Inspection

  AuthorityMode.[
    ObserveOnly
    ProposeOrders
    IssueOrders
  ]
  ChoreographyMode.[
    RecordOnly
    Recommend
    Decide
  ]
  IntentSynchronizationMode.[
    Disabled
    SummaryOnly
    FullRecord
  ]
  Configuration.{
    AuthorityMode
    ChoreographyMode
    IntentSynchronizationMode
  }

  PolicySection.[
    Authority
    Choreography
    IntentSynchronization
    All
  ]
  Inspection.PolicySection

  PolicySnapshotPayload.{
    PolicyRevision
    Configuration
  }

  ConfigurationRejectionReason.[
    SpiritAuthorityRequired
    PolicyWouldBreakChoreography
    IntentSynchronizationUnavailable
  ]
  ConfigurationRejectedPayload.ConfigurationRejectionReason

  OperationKind.[Configure Inspect]
  UnimplementedReason.[
    NotBuiltYet
    DependencyNotReady
    PolicyStoreUnavailable
  ]
  RequestUnimplementedPayload.{
    OperationKind
    UnimplementedReason
  }

  PolicyRevision.Integer
}
{}
{}
